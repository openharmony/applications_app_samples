{
  "app": {
    "signingConfigs": [

    ],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "compatibleSdkVersion": 18,
        "compileSdkVersion": 18,
        "runtimeOS": "OpenHarmony",
        "buildOption": {
          "strictMode": {
            "useNormalizedOHMUrl": true
          }
        }
      },
      {
        "name": "TV",
        "signingConfig": "default",
        "compileSdkVersion": 18,
        "compatibleSdkVersion": 18,
        "runtimeOS": "OpenHarmony",
        "buildOption": {
          "externalNativeOptions": {
            "abiFilters": ["arm64-v8a"]
          }
        }
      },
      {
        "name": "rk3568",
        "signingConfig": "default",
        "compileSdkVersion": 18,
        "compatibleSdkVersion": 18,
        "runtimeOS": "OpenHarmony",
        "buildOption": {
          "externalNativeOptions": {
            "abiFilters": ["arm64-v8a"]
          }
        }
      }
    ]
  },
  "modules": [
    {
      "name": "tv",
      "srcPath": "./product/tv",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    },
    {
      "name": "devicelibrary",
      "srcPath": "./features/devicelibrary"
    },
    {
      "name": "nearbydevice",
      "srcPath": "./features/nearbydevice"
    },
    {
      "name": "scenelibrary",
      "srcPath": "./features/scenelibrary"
    },
    {
      "name": "mine",
      "srcPath": "./features/mine"
    },
    {
      "name": "camera",
      "srcPath": "./features/camera"
    },
    {
      "name": "common",
      "srcPath": "./common"
    },
    {
      "name": "connect_iot",
      "srcPath": "./connect/connect_iot"
    },
    {
      "name": "connect_wifi",
      "srcPath": "./connect/connect_wifi"
    },
    {
      "name": "connect_ble",
      "srcPath": "./connect/connect_ble"
    },
    {
      "name": "connect_cloud",
      "srcPath": "./connect/connect_cloud",
    },
    {
      "name": "device_manager",
      "srcPath": "./connect/device_manager"
    }
  ]
}